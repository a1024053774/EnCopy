<Window x:Class="EnCopy.LinePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid x:Name="RootGrid" Background="{x:Null}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelSlideTransform" X="0" Y="0" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="208" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 屏幕顶部透明晾衣绳：画布自身保持 null 背景，所有未绘图素鼠标穿透到桌面底部窗口 -->
        <Canvas x:Name="LineCanvas"
                Grid.Row="0"
                Background="{x:Null}"
                ClipToBounds="True" />

        <!-- 搜索框与可展开篮子列表（水平居中在绳子正下方） -->
        <Border x:Name="SearchShell"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="420"
                Margin="0,2,0,8"
                CornerRadius="14"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.24" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <!-- 快捷键冲突提醒条（可点击直接打开改键界面） -->
                <Border x:Name="NoticeBanner"
                        Visibility="Collapsed"
                        Margin="10,8,10,0"
                        Padding="10,6"
                        CornerRadius="8"
                        BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonDown="NoticeBanner_MouseLeftButtonDown">
                    <TextBlock x:Name="NoticeText"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 搜索输入栏 -->
                <Grid Height="38" Margin="12,4,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SearchGlyph"
                               Grid.Column="0"
                               Text="⌕"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,7,1" />

                    <Border x:Name="ActiveFilterPill"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            CornerRadius="9"
                            Padding="7,2"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveFilterLabel"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <TextBox x:Name="QueryBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13.5"
                                 VerticalContentAlignment="Center"
                                 TextChanged="QueryBox_TextChanged" />
                        <TextBlock x:Name="PlaceholderText"
                                   IsHitTestVisible="False"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </Grid>

                    <TextBlock x:Name="CountText"
                               Grid.Column="3"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>

                <!-- 展开的篮子区域（按↓或点击「篮子 N 件 ↓」展开） -->
                <StackPanel x:Name="BasketSection" Visibility="Collapsed">
                    <StackPanel x:Name="BasketChipsBar"
                                Orientation="Horizontal"
                                Margin="10,2,10,8" />

                    <Border x:Name="BasketDivider" Height="1" Margin="0,0,0,4" />

                    <ScrollViewer x:Name="BasketScroller"
                                  MaxHeight="370"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BasketGroupsHost" Margin="0,2,0,8" />
                    </ScrollViewer>
                </StackPanel>

                <!-- 键盘操作提示条 -->
                <TextBlock x:Name="FooterHintText"
                           FontSize="10.5"
                           HorizontalAlignment="Center"
                           Margin="10,0,10,6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
